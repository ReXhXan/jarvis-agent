# LLM provider: openai | groq | ollama | mock
LLM_PROVIDER=mock
LLM_MODEL=llama3.1
OPENAI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Agent
MAX_TOOL_STEPS=5
MEMORY_WINDOW=12
DATA_DIR=./data
# Directories the file_search tool may read (comma separated)
FILE_SEARCH_ROOTS=.
# Weather uses the free Open-Meteo API (no key). Set false to disable network tools.
ALLOW_NETWORK=true
# Voice (needs: pip install -r requirements-voice.txt)
VOICE_ENABLED=false
LOG_LEVEL=INFO
